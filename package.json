{
  "name": "@1pizzateam/roostr",
  "version": "0.6.0",
  "description": "WebGL 3D engine written in TypeScript",
  "type": "module",
  "sideEffects": false,
  "main": "dist/roostr.js",
  "types": "dist/roostr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/roostr.d.ts",
      "import": "./dist/roostr.js"
    }
  },
  "keywords": [
    "webgl",
    "3d",
    "engine",
    "graphics",
    "mesh",
    "camera",
    "lights",
    "scene",
    "typescript"
  ],
  "homepage": "https://github.com/1pizzateam/RoostR.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1pizzateam/RoostR.js.git"
  },
  "bugs": {
    "url": "https://github.com/1pizzateam/RoostR.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run build:lib && npm run test",
    "build:lib": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@lcluber/type6js": "3.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.4.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3"
  }
}
